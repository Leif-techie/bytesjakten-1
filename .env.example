# Database – lokalt (SQLite) eller Render PostgreSQL
# Lokal utveckling:
# DATABASE_URL="file:./dev.db"
# Render (PostgreSQL – kopiera "Internal Database URL" från Render):
# DATABASE_URL="postgresql://user:pass@host/dbname"
DATABASE_URL="file:./dev.db"

# Email (Maileroo) – https://maileroo.com
# Skapa konto, lägg till/verifiera domän (t.ex. bytesjakten.se), skapa Sending Key
MAILEROO_API_KEY=
EMAIL_FROM="Bytesjakten <hej@bytesjakten.se>"

# App URL (för länkar i mejl – sätt till din riktiga domän i produktion)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Snap Pixel (Snapchat Ads) – Pixel ID från Events Manager
# Lämna tomt för att stänga av pixeln lokalt
NEXT_PUBLIC_SNAP_PIXEL_ID=

# Admin-lösenord för /admin (välj ett starkt lösenord!)
ADMIN_SECRET=byt-mig-till-ett-starkt-losenord

# Cron-säkerhet
CRON_SECRET=dev-secret-change-me

# Aktivera inbyggd cron kl 07:00 när servern körs (sätt true i start.ps1)
ENABLE_LOCAL_CRON=true
